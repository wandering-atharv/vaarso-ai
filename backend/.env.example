# ============================================================
# HeritageLens Backend Configuration (.env)
# Copy this file to backend/.env and populate your secret keys.
# Never commit .env to Git or expose keys in frontend code.
# ============================================================

# Sarvam AI (Text-to-Speech & Speech-to-Text)
# Obtain subscription key from https://www.sarvam.ai/
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3

# Google Gemini API (Historical Q&A Assistant, Inscription OCR & Translation)
# Obtain key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenAI (Optional secondary Whisper fallback)
OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=whisper-1

# CORS configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
